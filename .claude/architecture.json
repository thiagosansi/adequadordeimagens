{
  "pattern": "nextjs-app-router",
  "layers": {
    "app": {
      "pattern": "src/app/",
      "description": "Next.js App Router pages, layouts, and API routes"
    },
    "components": {
      "pattern": "src/components/",
      "description": "Reusable React components"
    },
    "lib": {
      "pattern": "src/lib/",
      "description": "Image processing logic, format definitions, and utilities"
    },
    "shared": {
      "pattern": "src/shared/",
      "description": "Types, constants, and cross-cutting concerns"
    }
  },
  "testMapping": {
    "src/lib/": "tests/unit/",
    "src/components/": "tests/unit/"
  },
  "testExtensions": [".test.ts", ".test.tsx", ".spec.ts", ".spec.tsx"],
  "implementationExtensions": [".ts", ".tsx"],
  "ignorePaths": ["node_modules/", ".git/", "dist/", "out/", "build/", "coverage/", ".next/"]
}
